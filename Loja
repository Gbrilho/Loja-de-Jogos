package loja;

public class Loja {

    private Console console;
    private Jogo[] jogos;

    public Loja(Console console, Jogo[] jogos) {
        this.console = console;
        this.jogos = jogos;
    }

    public Console getConsole() {
        return console;
    }

    public void setConsole(Console console) {
        this.console = console;
    }

    public Jogo[] getJogos() {
        return jogos;
    }

    public void setJogos(Jogo[] jogos) {
        this.jogos = jogos;
    }

    public int procuraJogos(String titulo) {
        for (int i = 0; i < jogos.length; i++) {
            if (jogos[i] != null && jogos[i].getTitulo().equals(titulo)) {
                return i;
            }
        }

        return -1;
    }

    public int jogosEmPromocao() {
        int quantidade = 0;

        for (int i = 0; i < jogos.length; i++) {
            if (jogos[i] != null && jogos[i].getPreco() <= 100) {
                quantidade++;
            }
        }

        return quantidade;
    }
}
