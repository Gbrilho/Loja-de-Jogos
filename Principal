package loja;

import java.util.Scanner;

public class Principal {

    public static void main(String[] args) {

        Scanner scanner = new Scanner(System.in);

        Console console = new Console("NextPlay", 5, 1000);
        Jogo[] jogos = new Jogo[12];

        for (int i = 0; i < jogos.length; i++) {

            System.out.println("Digite o título do jogo:");
            String titulo = scanner.nextLine();

            System.out.println("Digite o ano do jogo:");
            int ano = scanner.nextInt();

            System.out.println("Digite o preço do jogo:");
            double preco = scanner.nextDouble();

            scanner.nextLine();

            jogos[i] = new Jogo(titulo, ano, preco);
        }

        Loja loja = new Loja(console, jogos);

        int posicao = loja.procuraJogos("Aventura Final");

        if (posicao != -1) {
            System.out.println("O jogo está na posição: " + posicao);
        } else {
            System.out.println("O jogo não foi encontrado.");
        }

        System.out.println(
            "Quantidade de jogos em promoção: " + loja.jogosEmPromocao()
        );

        scanner.close();
    }
}
